SERVER_PORT=8998
GIN_MODE=release                 # debug for local development

# libsql: a local file, or libsql://<db>.turso.io?authToken=...
DATABASE_URL=file:locci.db

# Optional static admin token for machine-to-machine calls (e.g. the old
# API integration). Users log in with `locci login` / the web UI instead.
AUTH_TOKEN=

# Docker host; empty = local socket / DOCKER_HOST from the environment
DOCKER_HOST=

# Encrypts stored secrets (remote host TLS/SSH keys). Needed before adding a
# tcp+tls or ssh environment. Generate with: openssl rand -base64 32
# Keep it safe: changing or losing it makes stored keys unreadable.
LOCCI_SECRET_KEY=

TRAEFIK_DOMAIN=locci.cloud.localhost

# Deploy jobs from RabbitMQ (the consumer only starts when this is set)
RABBITMQ_URL=
QUEUE_NAME=deploy.trigger
DEPLOY_JOB_TIMEOUT=1800
